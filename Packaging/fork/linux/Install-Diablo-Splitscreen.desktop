#!/usr/bin/env xdg-open
[Desktop Entry]
Type=Application
Name=Install Diablo Splitscreen
Name[de]=Diablo Splitscreen installieren
Comment=Installs Diablo for up to four controllers on Steam Deck or Linux
Comment[de]=Installiert Diablo für bis zu vier Controller auf Steam Deck oder Linux
Exec=sh -c "f=\\$(mktemp) || exit 1; trap 'rm -f \\"\\$f\\"' EXIT; curl -fsSL --max-time 60 https://github.com/jarvis-jhk/diablo-splitscreen/releases/download/@TAG@/install.sh -o \\"\\$f\\" && grep -q 'END OF DIABLO SPLITSCREEN INSTALLER' \\"\\$f\\" && bash \\"\\$f\\" || { m='Downloading or running the installer failed. Please try again. / Der Installer konnte nicht geladen oder gestartet werden. Bitte erneut versuchen.'; zenity --error --text=\\"\\$m\\" || kdialog --error \\"\\$m\\"; exit 1; }"
Icon=applications-games
Terminal=true
Categories=Game;
StartupNotify=false
